# Figma API Configuration
# Get your personal access token from: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=

# Extract the file key from your Figma URL
# Example: https://www.figma.com/file/ABC123DEF456/My-Design-File
# The file key would be: ABC123DEF456
FIGMA_FILE_KEY=
